# Public site URL for metadata (production)
NEXT_PUBLIC_SITE_URL=https://example.com

# Contact email shown on /contact (mailto)
NEXT_PUBLIC_CONTACT_EMAIL=contact@your-domain.com

# Google AdSense (optional — placeholders show until set)
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_SLOT_HOME=home-inline
NEXT_PUBLIC_ADSENSE_SLOT_HOME_BOTTOM=home-bottom
NEXT_PUBLIC_ADSENSE_SLOT_BLOG=blog-inline
