# Public site URL for metadata, canonical URLs, sitemap, robots (production)
NEXT_PUBLIC_SITE_URL=https://example.com

# Contact email shown on /contact (mailto)
NEXT_PUBLIC_CONTACT_EMAIL=contact@your-domain.com

# Optional: show dashed ad placeholder boxes before AdSense approval (default: hidden)
# NEXT_PUBLIC_SHOW_AD_PLACEHOLDER=true
