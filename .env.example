# Public site URL for metadata, canonical URLs, sitemap, robots
# AdSense·Search Console에 등록한 URL과 반드시 동일하게 설정하세요.
NEXT_PUBLIC_SITE_URL=https://www.compressdeck.com

# Contact email shown on /contact (mailto)
NEXT_PUBLIC_CONTACT_EMAIL=mmi.dellla@gmail.com

# ── 관리자 패널 ───────────────────────────────────────────────────────────────
# /admin 로그인 비밀번호 (Vercel 환경변수에 설정)
ADMIN_PASSWORD=your-secure-password-here

# GitHub API (블로그 글 저장용 — posts/*.json 파일을 커밋합니다)
# Fine-grained Personal Access Token: Contents Read & Write 권한 필요
# 발급: https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=github_pat_...
GITHUB_REPO_OWNER=dongjulab
GITHUB_REPO_NAME=image-compressor
